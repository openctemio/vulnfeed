  "workarounds": [
    {"text": "Turn HTTP/2 off on affected listeners (http2 off; from 1.25.1, otherwise remove http2 from listen).", "blocks": ["CVE-2026-123007", "CVE-2026-123633"], "caveat": "Breaks gRPC and other clients that need HTTP/2, and leaves the other three vulnerabilities open: not a complete mitigation.", "sources": ["circl-tr105"]},
    {"text": "Restrict mail proxy listeners to trusted networks.", "blocks": ["CVE-2026-113425"], "sources": ["cve-2026-113425"]},
    {"text": "Avoid SSI and mirror directives, and avoid a proxied server name built from variables.", "blocks": ["CVE-2026-123634"], "sources": ["cve-2026-123634"]}
  ],
  "detection": [
    {"kind": "version_check", "text": "Read the version with nginx -v; many servers hide it in the Server header (server_tokens off).", "sources": ["circl-tr105"]},
    {"kind": "safe_check", "text": "Check whether a TLS listener offers HTTP/2 through ALPN h2 (for example openssl s_client -alpn h2).", "sources": ["circl-tr105"]},
    {"kind": "config_check", "text": "Search the effective configuration (nginx -T) for http2, quic, resolver, mirror, proxy_pass and auth_http.", "sources": ["circl-tr105"]},
    {"kind": "log_hint", "text": "Look for worker processes that exited on signal 11 or segfaults in the nginx error log, and for nginx core dumps.", "sources": ["circl-tr105"]},
    {"kind": "host_hint", "text": "Look for nginx worker processes starting unexpected programs or opening unusual outbound connections or DNS lookups.", "sources": ["circl-tr105"]}
  ],
