    {"id": "CVE-2026-123007", "title": "Memory corruption in HTTP/2 flow control", "sources": ["nginx-advisories", "cve-2026-123007"]},
    {"id": "CVE-2026-123633", "title": "Use-after-free in HTTP/2", "sources": ["nginx-advisories", "cve-2026-123633"]},
    {"id": "CVE-2026-123634", "title": "Use-after-free during response processing in resolver", "sources": ["nginx-advisories", "cve-2026-123634"]}
